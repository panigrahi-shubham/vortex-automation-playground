generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  avatar       String?
  avatarData   Avatar?
  phone        String @default("")
  settings     Json @default("{\"orderEmails\":true,\"marketingEmails\":false,\"theme\":\"system\",\"reducedMotion\":false}")
  role         String   @default("customer")
  locked       Boolean  @default(false)
  createdAt    DateTime @default(now())
  sessions     Session[]
  orders       Order[]
  cart         Cart?
  wishlist     WishlistEntry[]
  reviews      Review[]
  recovery     RecoveryChallenge?
  testMails    TestMail[]
  mfa         MfaCredential?
  mfaLogins   MfaLogin[]
  backupCodes MfaBackupCode[]
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model Avatar {
  id     String @id
  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  data   Bytes
}

model RateLimit {
  key      String @id
  count    Int
  resetsAt DateTime
  @@index([resetsAt])
}

model MfaCredential {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String
  enabled Boolean @default(false)
  lastStep Int @default(-1)
  expiresAt DateTime
}
model MfaLogin {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  remember Boolean @default(false)
  attempts Int @default(0)
  expiresAt DateTime
  @@index([userId])
}
model MfaBackupCode {
  codeHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model RecoveryChallenge {
  userId    String @id
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int @default(0)
  expiresAt DateTime
}

model TestMail {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  to        String
  subject   String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId, createdAt])
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String
  category    String
  price       Decimal  @db.Decimal(12, 2)
  stock       Int
  variants    Json?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartLines   CartLine[]
  wishlist    WishlistEntry[]
  reviews     Review[]
  rating      Decimal @default(0) @db.Decimal(2, 1)
  reviewCount Int @default(0)
  @@index([category, deletedAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    String?
  shipping  String     @default("standard")
  lines     CartLine[]
}

model Review {
  id        String @id @default(cuid())
  userId    String
  productId Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())
  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model WishlistEntry {
  userId    String
  productId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, productId])
  @@index([productId])
}

model CartLine {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  variant   String  @default("")
  @@unique([cartId, productId, variant])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  idempotencyKey String
  status         String      @default("Placed")
  total          Decimal     @db.Decimal(12, 2)
  address        Json
  pricing        Json?
  paymentLast4   String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lines          OrderLine[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

// Immutable snapshots deliberately survive product deletion.
model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name      String
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  variant   String
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  leaseToken  String?
  leaseUntil  DateTime?
  lastError   String?
  @@index([deliveredAt, availableAt, leaseUntil])
}


