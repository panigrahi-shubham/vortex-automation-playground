# Supabase: copy exact host and username from your project's Connect panel.
# Runtime: transaction pooler (Prisma 7 PostgreSQL adapter).
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require&schema=orvilo"
# Migrations: session pooler (works on IPv4) or direct database connection.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&schema=orvilo"

# Development-only secret for protected test inbox; leave unset in production.
ORVILO_TEST_KEY=

# Stable 32-byte base64 key for encrypting authenticator secrets. Keep it across deployments.
ORVILO_MFA_KEY=
