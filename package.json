{
  "name": "orvilo",
  "version": "2.0.0",
  "description": "ShopLab v2 - an end-to-end e-commerce playground for Playwright practice (UI, API, network, chaos and seeded bugs)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:api": "playwright test --project=api",
    "test:bugs": "playwright test --project=bugs",
    "report": "playwright show-report",
    "typecheck": "tsc -p .",
    "test:workflows": "node --test tests/workflows/*.test.js",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-database.cjs",
    "db:seed:catalog": "node scripts/seed-catalog.cjs",
    "postinstall": "prisma generate",
    "prestart": "npm run build",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "vercel-build": "npm run build",
    "predev": "npm run build",
    "test:db": "npm run build && node --test tests/workflows/database-*.test.cjs",
    "test:pricing": "npm run build && node --test tests/workflows/pricing.test.cjs",
    "smoke:storefront:db": "node scripts/smoke-v2-storefront.cjs",
    "test:storefront-adapter": "node --test tests/workflows/storefront-adapter.test.cjs",
    "test:inbox": "node scripts/test-inbox.cjs",
    "admin:grant": "node scripts/grant-admin.cjs"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "otplib": "13.4.0",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "prisma": "7.10.1",
    "typescript": "^5.9.3"
  }
}
