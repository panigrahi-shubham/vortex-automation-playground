{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".vortex-static",
  "headers": [
    {
      "source": "/:folder(assets|css|js)/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "{web,dist,server/certs,node_modules/.prisma,node_modules/three/build}/**"
    }
  }
}
