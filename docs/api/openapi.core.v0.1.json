            "discount": 0,
            "coupon": null,
            "couponError": null,
            "shippingMethod": "standard",
            "shipping": 5.99,
            "tax": 6.4,
            "total": 92.37
          },
          "paymentLast4": "TEST",
          "createdAt": "2026-10-30T10:00:00.000Z",
          "updatedAt": "2026-10-30T10:00:00.000Z",
          "lines": [
            {
              "id": "order_line_example_001",
              "orderId": "order_example_001",
              "productId": 101,
              "name": "Example Robot Kit",
              "sku": "SL-EXM-101",
              "quantity": 2,
              "unitPrice": 39.99,
              "variant": ""
            }
          ],
          "paymentMode": "simulated"
        }
      }
    },
    "responses": {
      "MalformedJson": {
        "description": "The request body is not valid JSON.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Malformed JSON body" }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The JSON request body exceeds the current 200 KB parser limit.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Payload too large" }
          }
        }
      },
      "UnsupportedEncoding": {
        "description": "The request uses compressed or otherwise unsupported body encoding.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Compressed request bodies are not supported" }
          }
        }
      },
      "InternalServerError": {
        "description": "Unhandled route or middleware failure returned by the shared API error handler.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Internal server error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing/malformed Bearer credentials produce Unauthorized. A well-formed token with no live session produces Session expired with code SESSION_EXPIRED.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "missingOrMalformed": { "value": { "error": "Unauthorized" } },
              "missingExpiredOrRevokedSession": { "value": { "error": "Session expired", "code": "SESSION_EXPIRED" } }
            }
          }
        }
      },
      "LockedAccount": {
        "description": "The authenticated or authenticating account is locked.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "This account is locked" }
          }
        }
      },
      "LoginThrottled": {
        "description": "The current login throttle rejected the attempt. No equivalent rate-limit response is declared for the other operations in this partial contract.",
        "headers": {
          "Retry-After": {
            "description": "Whole seconds until the current bucket resets; always at least one.",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Too many sign-in attempts. Try again later." }
          }
        }
      }
    }
  }
